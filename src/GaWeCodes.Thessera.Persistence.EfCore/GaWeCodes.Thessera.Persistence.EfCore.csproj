<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The database-agnostic half of Thessera state-stored persistence: state reconciliation, repository, aggregate tracker, unit of work, typed-key conversions and read-model rebuild. It defines IEfCoreDatabaseDriver and implements none - for PostgreSQL install GaWeCodes.Thessera.Persistence.EfCore.Postgres.</Description>
    <PackageTags>efcore;entity-framework;persistence;unit-of-work;repository;wolverine</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GaWeCodes.Thessera.Core\GaWeCodes.Thessera.Core.csproj" />
    <ProjectReference Include="..\GaWeCodes.Thessera.Wolverine\GaWeCodes.Thessera.Wolverine.csproj" />
  </ItemGroup>

</Project>
